```cshtml
@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "New Service Request";

    var contractsForJs =
        (ViewBag.Contracts as List<GLMS.Web.Models.Contract>)
        ?? new List<GLMS.Web.Models.Contract>();

    var selectedContractId = ViewBag.SelectedContractId as int?;
}

<h2 class="mb-4">New Service Request</h2>

<div class="alert alert-info d-inline-block mb-4">
    Current USD → ZAR Rate:
    <strong>R @ViewBag.Rate</strong>
</div>

<form asp-controller="ServiceRequests"
      asp-action="Create"
      method="post"
      style="max-width:640px;">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">
            Client
        </label>

        <select id="clientFilter" class="form-select">
            <option value="">-- Select Client --</option>

            @foreach (var client in
                        (ViewBag.Clients as Microsoft.AspNetCore.Mvc.Rendering.SelectList
                        ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
                        new List<object>())))
            {
                <option value="@client.Value">
                    @client.Text
                </option>
            }
        </select>

        <small class="text-muted">
            Pick a client to filter their contracts below.
        </small>
    </div>

    <div class="mb-3">
        <label asp-for="ContractId"
               class="form-label fw-semibold">
            Contract
        </label>

        <select asp-for="ContractId"
                id="contractSelect"
                class="form-select">

            <option value="">
                -- Select a client first --
            </option>

            @foreach (var contract in contractsForJs)
            {
                var label =
                $"{contract.Client?.Name ?? "Client #" + contract.ClientId} — " +
                $"{contract.ServiceLevel} (Active)";

                var isSelected =
                selectedContractId.HasValue &&
                selectedContractId.Value == contract.Id;

                if (isSelected)
                {
                    <option value="@contract.Id"
                            data-client="@contract.ClientId"
                            selected="selected">
                        @label
                    </option>
                }
                else
                {
                    <option value="@contract.Id"
                            data-client="@contract.ClientId">
                        @label
                    </option>
                }
            }
        </select>

        <span asp-validation-for="ContractId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label fw-semibold">
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"
                  placeholder="Describe the service being requested...">
        </textarea>

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="CostUSD"
               class="form-label fw-semibold">
            Cost (USD)
        </label>

        <input asp-for="CostUSD"
               class="form-control"
               type="number"
               min="0"
               step="0.01"
               placeholder="0.00" />

        <span asp-validation-for="CostUSD"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Status"
               class="form-label fw-semibold">
        </label>

        <select asp-for="Status" class="form-select">
            <option value="Pending">Pending</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
        </select>

        <span asp-validation-for="Status"
              class="text-danger">
        </span>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-success">
            Save Request
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document
            .getElementById('clientFilter')
            .addEventListener('change', function () {

                const selectedClientId = this.value;
                const contractSelect =
                    document.getElementById('contractSelect');

                const options =
                    contractSelect.querySelectorAll(
                        'option[data-client]'
                    );

                contractSelect.value = '';

                options.forEach(option => {
                    const optionClientId =
                        option.getAttribute('data-client');

                    if (
                        selectedClientId === '' ||
                        optionClientId === selectedClientId
                    ) {
                        option.style.display = '';
                    } else {
                        option.style.display = 'none';
                    }
                });

                const firstOption =
                    contractSelect.querySelector(
                        'option:not([data-client])'
                    );

                if (firstOption) {
                    firstOption.text =
                        selectedClientId === ''
                            ? '-- Select a client first --'
                            : '-- Select Contract --';
                }
            });
    </script>
}

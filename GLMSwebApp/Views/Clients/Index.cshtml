@model IEnumerable<GLMS.Web.Models.Client>
<h2>Clients</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Client</a>
<table class="table table-bordered">
    <thead>
        <tr><th>Name</th><th>Contact</th><th>Region</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.ContactDetails</td>
                <td>@c.Region</td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this client?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

